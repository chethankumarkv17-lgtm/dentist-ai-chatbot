# ==============================================================================
# RADIANT NOBEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' for local development.
# NEVER commit real credentials, production secrets, or '.env.local' to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# App / Domain Configuration (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase (Database, Auth, and Storage)
# ------------------------------------------------------------------------------
# Public Supabase API URL and anonymous client key
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only Service Role Key (bypasses Row-Level Security for admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# AI Receptionist (Anthropic Claude API)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Payments & Subscriptions (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ------------------------------------------------------------------------------
# Transactional Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=appointments@yourclinic.com

# ------------------------------------------------------------------------------
# WhatsApp Integration (Meta WhatsApp Business Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here

# ------------------------------------------------------------------------------
# Voice Receptionist (Twilio Telephony) - Optional
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ------------------------------------------------------------------------------
# Distributed Rate Limiting & Cache (Upstash Redis) - Optional
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ------------------------------------------------------------------------------
# Development & Testing Feature Flags
# ------------------------------------------------------------------------------
# Set to 'true' to allow one-click demo login without active Supabase credentials
ENABLE_DEMO_LOGIN=false
